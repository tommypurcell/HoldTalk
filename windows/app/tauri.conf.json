{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoldTalk",
  "version": "0.1.0",
  "identifier": "com.tommypurcell.holdtalk",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "whisper/": "whisper/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
